#!/bin/sh
# Nix on this VM: files on the regular filesystems get an immutable
# 'hatch_tainted' xattr that Nix normally cannot strip; /etc/nix/nix.conf
# lists it in `ignored-acls`, so the store can live on the real disk.
# Store backing: /home/hatch/nixdisk (100G volume). Each session must
# bind-mount it over /nix first (mounts don't persist across sessions).
# A fresh boot has a fresh root overlay: /nix itself may not exist yet.
[ -d /nix ] || mkdir -p /nix 2>/dev/null
if ! mountpoint -q /nix 2>/dev/null; then
  if [ -d /home/hatch/nixdisk/store ]; then
    mount --bind /home/hatch/nixdisk /nix
  else
    mount --bind /var/tmp/nixroot /nix
  fi
fi
# /etc/nix/nix.conf also lives on the ephemeral overlay; recreate if absent.
# Without it, installs fail: the store's files carry the immutable
# 'hatch_tainted' xattrs and stock Nix cannot strip them (ignored-acls),
# and the sandboxed root builder cannot write the store (sandbox = false).
if [ ! -f /etc/nix/nix.conf ]; then
  mkdir -p /etc/nix 2>/dev/null
  # The ignored-acls list is single-sourced in ignored-acls.txt
  # (INSTALL.md sections 4 and 10); fall back to the built-in
  # list if that file is unavailable.
  ACL_FILE=/home/hatch/workspace/nix/ignored-acls.txt
  if [ -f "$ACL_FILE" ]; then
    ACL_VALUE=$(grep -v -e '^#' -e '^$' "$ACL_FILE" | tr '\n' ' ' | sed 's/  */ /g; s/ $//')
  else
    ACL_VALUE='security.csm security.selinux system.nfs4_acl security.tamper_marker user.hatch_tainted user.hatch_tainted.n user.hatch_tainted.u'
  fi
  cat > /etc/nix/nix.conf 2>/dev/null <<EOF
sandbox = false
build-users-group =
experimental-features = nix-command flakes
ignored-acls = $ACL_VALUE
EOF
fi
# The profile symlink lives in /root (ephemeral overlay) while the profile
# itself lives in the store volume; a reboot wipes the link, so recreate it.
if [ ! -e /root/.nix-profile ] && [ -e /nix/var/nix/profiles/default ]; then
  ln -s /nix/var/nix/profiles/default /root/.nix-profile 2>/dev/null
fi
if [ ! -e /root/.nix-channels ] && [ -e /nix/var/nix/profiles/per-user/root/channels ]; then
  printf '%s\n' 'https://channels.nixos.org/nixpkgs-unstable nixpkgs' > /root/.nix-channels 2>/dev/null
fi
# Companion service bootstrap (opt-in): on nix invocations, keep the
# full tailscaled running and connected. Cheap no-op when already
# healthy; failures never block the nix command itself.
if [ -f /home/hatch/.config/vm-tailscale/autostart ]; then
  /home/hatch/scripts/bootstrap-tailscale.sh >/dev/null 2>&1 || true
fi

# Same opt-in pattern for the API Bridge server (module: api-bridge):
# keep the OpenAI-compatible bridge server running; no-op when already up.
if [ -f /home/hatch/.config/vm-api-bridge/autostart ]; then
  /home/hatch/scripts/bootstrap-api-bridge.sh >/dev/null 2>&1 || true
fi
# BEGIN local-only
# END local-only
export PATH="/root/.nix-profile/bin:$PATH"

# xattr-retry shim: pads extended-attribute list size probes so
# asynchronous taint-marking cannot overflow Nix's read buffer
# mid-listing (INSTALL.md sections 4 and 10). The shim is
# ensured here, in code, not left to a setup step: if the .so
# is missing, fetch the pinned CI-built release asset and
# verify it against the pinned checksum before use. The same
# pin lives in setup-nix.sh; update both together. If the
# fetch fails, warn and continue unshimmed (the section 4
# fallback procedure then applies to installs). A .so already
# present (for example a source build for another
# architecture) is never overwritten.
XATTR_SHIM=/home/hatch/bin/xattr-retry.so
XATTR_SHIM_URL=https://github.com/dahjah/muse-vm-nix-and-ssh-enablement/releases/download/shim-v1/xattr-retry.so
XATTR_SHIM_SHA256=19038c96d55f08eda8388b41a68be4c9bcdc3554fa7fc6e1fe5985c5189852e2
if [ ! -f "$XATTR_SHIM" ]; then
  shim_tmp="$XATTR_SHIM.tmp.$$"
  if command -v curl >/dev/null 2>&1 && \
     curl -fsSL --max-time 30 -o "$shim_tmp" "$XATTR_SHIM_URL" 2>/dev/null && \
     echo "$XATTR_SHIM_SHA256  $shim_tmp" | sha256sum -c - >/dev/null 2>&1; then
    mv "$shim_tmp" "$XATTR_SHIM"
  else
    rm -f "$shim_tmp"
    echo "nixwrap: warning: xattr-retry shim could not be fetched; continuing without it (INSTALL.md section 4 fallback applies)" >&2
  fi
fi
if [ -f "$XATTR_SHIM" ]; then
  LD_PRELOAD="$XATTR_SHIM${LD_PRELOAD:+:$LD_PRELOAD}"
  export LD_PRELOAD
fi
tool=$(basename "$0")
if [ "$tool" = "nixwrap" ] || [ "$tool" = "nixsh" ]; then
  if [ $# -gt 0 ]; then exec bash -c "$1"; else exec bash; fi
fi
exec "/root/.nix-profile/bin/$tool" "$@"
